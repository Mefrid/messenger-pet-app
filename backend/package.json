{
  "name": "messenger-pet-backend",
  "version": "1.0.0",
  "description": "Backend for messenger",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "npm run typecheck && tsup",
    "typecheck": "tsc",
    "dev": "tsx watch ./src/app.ts",
    "start": "node ./dist/app.cjs",
    "migrate": "node-pg-migrate -m './src/implementation/infrastructure/database/migrations' up",
    "migrate:down": "node-pg-migrate -m './src/implementation/infrastructure/database/migrations' down",
    "migrate:create": "node-pg-migrate -m './src/implementation/infrastructure/database/migrations' create -j ts",
    "seed:users": "tsx src/implementation/infrastructure/database/seeds/seedUsers.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.4",
    "pg": "^8.23.0",
    "node-pg-migrate": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.21.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
